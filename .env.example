# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=
MAX_ACCOUNTS_PER_USER=5

# MongoDB Database URI (Must point to a replica set for transactions)
MONGO_URI=mongodb://localhost:27017/ledger_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Security (Use a strong random secret, >= 32 characters)
JWT_SECRET=your_super_secret_jwt_key_here_at_least_32_chars
JWT_EXPIRES_IN=1d

# Email Configuration (Nodemailer OAuth2)
EMAIL_USER=your_email@gmail.com
CLIENT_ID=your_oauth2_client_id
CLIENT_SECRET=your_oauth2_client_secret
REFRESH_TOKEN=your_oauth2_refresh_token
ADMIN_EMAIL=
